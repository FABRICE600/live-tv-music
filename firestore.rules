rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwnerPath(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function parentUserExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function isValidUserPublicProfile(data, userId) {
      return data.keys().hasAll(['ownerUid', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'displayName', 'photoUrl', 'createdAt', 'updatedAt'])
        && data.ownerUid is string
        && data.ownerUid == request.auth.uid
        && data.ownerUid == userId
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 512))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['ownerUid', 'email', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'email', 'updatedAt'])
        && data.ownerUid is string
        && data.ownerUid == request.auth.uid
        && data.ownerUid == userId
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.updatedAt is timestamp;
    }

    function isValidUserLibraryState(data, userId) {
      return data.keys().hasAll(['ownerUid', 'likedIds', 'pinnedMatchIds', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'likedIds', 'pinnedMatchIds', 'updatedAt'])
        && data.ownerUid is string
        && data.ownerUid == request.auth.uid
        && data.ownerUid == userId
        && data.likedIds is list
        && data.likedIds.size() <= 200
        && (data.likedIds.size() == 0 || (data.likedIds[0] is string && data.likedIds[0].size() <= 128))
        && data.pinnedMatchIds is list
        && data.pinnedMatchIds.size() <= 50
        && (data.pinnedMatchIds.size() == 0 || (data.pinnedMatchIds[0] is string && data.pinnedMatchIds[0].size() <= 128))
        && data.updatedAt is timestamp;
    }

    function isValidUserPlaylist(data, userId) {
      return data.keys().hasAll(['ownerUid', 'name', 'trackIds', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'name', 'description', 'trackIds', 'createdAt', 'updatedAt'])
        && data.ownerUid is string
        && data.ownerUid == request.auth.uid
        && data.ownerUid == userId
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 80
        && (!('description' in data) || (data.description is string && data.description.size() <= 300))
        && data.trackIds is list
        && data.trackIds.size() <= 200
        && (data.trackIds.size() == 0 || (data.trackIds[0] is string && data.trackIds[0].size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStageScore(data) {
      return data.keys().hasAll(['ownerUid', 'playerName', 'score', 'maxCombo', 'accuracy', 'difficulty', 'createdAt'])
        && data.keys().hasOnly(['ownerUid', 'playerName', 'score', 'maxCombo', 'accuracy', 'difficulty', 'createdAt'])
        && data.ownerUid is string
        && data.ownerUid == request.auth.uid
        && data.playerName is string
        && data.playerName.size() >= 1
        && data.playerName.size() <= 60
        && data.score is int
        && data.score >= 0
        && data.score <= 10000000
        && data.maxCombo is int
        && data.maxCombo >= 0
        && data.maxCombo <= 10000
        && data.accuracy is int
        && data.accuracy >= 0
        && data.accuracy <= 100
        && data.difficulty is string
        && data.difficulty in ['chill', 'studio', 'encore']
        && data.createdAt is timestamp;
    }

    // 3. Public non-PII user profile
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if false;
      allow create: if isOwnerPath(userId)
        && isValidId(userId)
        && isValidUserPublicProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwnerPath(userId)
        && isValidId(userId)
        && isValidUserPublicProfile(incoming(), userId)
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'updatedAt']);
      allow delete: if false;

      // 4. Isolated PII subcollection
      match /private/info {
        allow get: if isOwnerPath(userId);
        allow list: if false;
        allow create: if isOwnerPath(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().updatedAt == request.time
          && parentUserExists(userId);
        allow update: if isOwnerPath(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt'])
          && parentUserExists(userId);
        allow delete: if isOwnerPath(userId);
      }

      // 5. Owner-only Library Sync State
      match /library/state {
        allow get: if isOwnerPath(userId);
        allow list: if false;
        allow create: if isOwnerPath(userId)
          && isValidUserLibraryState(incoming(), userId)
          && incoming().updatedAt == request.time
          && parentUserExists(userId);
        allow update: if isOwnerPath(userId)
          && isValidUserLibraryState(incoming(), userId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['likedIds', 'pinnedMatchIds', 'updatedAt'])
          && parentUserExists(userId);
        allow delete: if isOwnerPath(userId);
      }

      // 6. Owner-only User Playlists
      match /playlists/{playlistId} {
        allow get: if isOwnerPath(userId) && isValidId(playlistId);
        allow list: if isOwnerPath(userId) && existing().ownerUid == request.auth.uid;
        allow create: if isOwnerPath(userId)
          && isValidId(playlistId)
          && isValidUserPlaylist(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentUserExists(userId);
        allow update: if isOwnerPath(userId)
          && isValidId(playlistId)
          && isValidUserPlaylist(incoming(), userId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'trackIds', 'updatedAt'])
          && parentUserExists(userId);
        allow delete: if isOwnerPath(userId) && isValidId(playlistId);
      }
    }

    // 7. 3D Stage Game Leaderboard (immutable entries)
    match /stageScores/{scoreId} {
      allow get: if isSignedIn() && isValidId(scoreId);
      allow list: if isSignedIn();
      allow create: if isVerifiedUser()
        && isValidId(scoreId)
        && isValidStageScore(incoming())
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isVerifiedUser()
        && isValidId(scoreId)
        && existing().ownerUid == request.auth.uid;
    }
  }
}
